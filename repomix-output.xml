<file path="resources/js/Pages/Dashboard/Components/CalendarModal.jsx">
import React, { useState, useEffect } from 'react';
import { STATUS_COLORS, FILTER_LABELS } from './calendarHelpers';
import dayjs from 'dayjs';

// ─── Helpers ────────────────────────────────────────────────────────────────

function getDaysInMonth(year, month) {
    return new Date(year, month + 1, 0).getDate();
}

function getFirstDayOfMonth(year, month) {
    return new Date(year, month, 1).getDay();
}

function formatMonthYear(year, month) {
    return new Date(year, month, 1).toLocaleString('default', {
        month: 'long',
        year: 'numeric',
    });
}

const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

/**
 * Statuses we consider "active" for the calendar view.
 * `completed` and `cancelled` are intentionally excluded so the calendar
 * reflects what's still scheduled, not what's already done.
 */
const ACTIVE_STATUSES = ['pending', 'confirmed', 'scheduled', 'rescheduled'];

/**
 * Resolve an appointment's canonical status.
 * Explicit status wins; otherwise fall back to a date comparison.
 */
function getApptStatus(appt) {
    const raw = appt.next_appointment_raw || appt.next_appointment;
    if (!raw) return null;

    const status = String(appt.visit_status || '').toLowerCase();

    // Explicit outcomes win
    if (['completed', 'cancelled', 'rescheduled'].includes(status)) {
        return status;
    }

    const now = new Date();
    const at = new Date(raw);

    if (at.toDateString() === now.toDateString()) return 'today';
    if (at > now) return 'upcoming';
    return 'missed';
}

function dayBadgeColor(dayAppts) {
    const statuses = dayAppts.map((a) => getApptStatus(a));
    if (statuses.includes('missed'))      return 'missed';
    if (statuses.includes('rescheduled')) return 'rescheduled';
    if (statuses.includes('confirmed'))   return 'confirmed';
    if (statuses.includes('upcoming'))    return 'upcoming';
    if (statuses.includes('today'))       return 'today';
    return null;
}

export default function CalendarModal({ appointments, onClose, initialFilter = null }) {
    const today    = new Date();
    const todayStr = today.toISOString().slice(0, 10);

    const [viewYear,   setViewYear]   = useState(today.getFullYear());
    const [viewMonth,  setViewMonth]  = useState(today.getMonth());
    const [selectedDay, setSelectedDay] = useState(null);
    const [activeFilter, setActiveFilter] = useState(initialFilter); // null | 'missed' | 'today' | 'upcoming'

    // Sync if parent changes filter
    useEffect(() => {
        setActiveFilter(initialFilter);
        setSelectedDay(null);
    }, [initialFilter]);

    // When a filter activates, jump to today if it's the "today" filter
    useEffect(() => {
        if (!activeFilter) return;

        if (activeFilter === 'today') {
            setViewYear(today.getFullYear());
            setViewMonth(today.getMonth());
            setSelectedDay(today.getDate());
            return;
        }

        setSelectedDay(null);
        // eslint-disable-next-line react-hooks/exhaustive-deps
    }, [activeFilter]);

    // ── Filter appointments ────────────────────────────────────────────
    // Always exclude completed/cancelled so the calendar only shows live work.
    const activeAppointments = appointments.filter((a) =>
        ACTIVE_STATUSES.includes(String(a.visit_status || '').toLowerCase())
    );

    const visibleAppointments = activeFilter
        ? activeAppointments.filter((a) => {
              const raw = a.next_appointment_raw || a.next_appointment;
              if (!raw) return false;
              const apptDate = new Date(raw);

              if (activeFilter === 'today') {
                  return apptDate.toDateString() === today.toDateString();
              }
              if (activeFilter === 'missed') {
                  return apptDate < today;
              }
              if (activeFilter === 'upcoming') {
                  return apptDate > today;
              }
              return false;
          })
        : activeAppointments;

    // ── Group by date ─────────────────────────────────────────────────
    const apptsByDate = {};
    visibleAppointments.forEach((appt) => {
        const raw = appt.next_appointment_raw || appt.next_appointment;
        const parsed = new Date(raw);
        if (!isNaN(parsed)) {
            const key = parsed.toISOString().slice(0, 10);
            if (!apptsByDate[key]) apptsByDate[key] = [];
            apptsByDate[key].push(appt);
        }
    });

    const daysInMonth = getDaysInMonth(viewYear, viewMonth);
    const firstDay    = getFirstDayOfMonth(viewYear, viewMonth);

    function prevMonth() {
        if (viewMonth === 0) { setViewYear(y => y - 1); setViewMonth(11); }
        else setViewMonth(m => m - 1);
        setSelectedDay(null);
    }

    function nextMonth() {
        if (viewMonth === 11) { setViewYear(y => y + 1); setViewMonth(0); }
        else setViewMonth(m => m + 1);
        setSelectedDay(null);
    }

    const cells = [];
    for (let i = 0; i < firstDay; i++) cells.push(null);
    for (let d = 1; d <= daysInMonth; d++) cells.push(d);

    const selectedDateStr = selectedDay
        ? `${viewYear}-${String(viewMonth + 1).padStart(2, '0')}-${String(selectedDay).padStart(2, '0')}`
        : null;

    const selectedAppts =
        activeFilter === 'today'
            ? apptsByDate[todayStr] ?? []
            : selectedDateStr
                ? apptsByDate[selectedDateStr] ?? []
                : [];

    // ── Filter pill counts ────────────────────────────────────────────
    const counts = {
        missed: activeAppointments.filter((a) => {
            const raw = a.next_appointment_raw || a.next_appointment;
            return raw && new Date(raw) < today;
        }).length,

        today: activeAppointments.filter((a) => {
            const raw = a.next_appointment_raw || a.next_appointment;
            return raw && new Date(raw).toDateString() === today.toDateString();
        }).length,

        upcoming: activeAppointments.filter((a) => {
            const raw = a.next_appointment_raw || a.next_appointment;
            return raw && new Date(raw) > today;
        }).length,
    };

    return (
        <div
            className="fixed inset-0 z-50 flex items-center justify-center"
            style={{ backgroundColor: 'rgba(0,0,0,0.45)', backdropFilter: 'blur(2px)' }}
            onClick={(e) => { if (e.target === e.currentTarget) onClose(); }}
        >
            <div className="bg-white rounded-2xl shadow-2xl w-full max-w-2xl mx-4 overflow-hidden">

                {/* Modal Header */}
                <div className="flex items-center justify-between px-6 py-4 border-b border-gray-100">
                    <h2 className="text-lg font-bold text-gray-800">Appointment Calendar</h2>
                    <button
                        onClick={onClose}
                        className="text-gray-400 hover:text-gray-600 transition-colors text-xl leading-none"
                        aria-label="Close"
                    >
                        ✕
                    </button>
                </div>

                {/* Filter Pills */}
                <div className="flex items-center gap-2 px-6 pt-4">
                    <button
                        onClick={() => { setActiveFilter(null); setSelectedDay(null); }}
                        className={`text-xs font-semibold px-3 py-1 rounded-full border transition-colors
                            ${activeFilter === null
                                ? 'bg-gray-800 text-white border-gray-800'
                                : 'bg-gray-100 text-gray-600 border-gray-200 hover:bg-gray-200'}`}
                    >
                        All ({activeAppointments.length})
                    </button>

                    {(['missed', 'today', 'upcoming']).map((f) => (
                        <button
                            key={f}
                            onClick={() => { setActiveFilter(prev => (prev === f ? null : f)); setSelectedDay(null); }}
                            className={`flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full border transition-colors
                                ${activeFilter === f
                                    ? `${STATUS_COLORS[f]?.bg ?? 'bg-gray-800'} ${STATUS_COLORS[f]?.text ?? 'text-white'} border-transparent`
                                    : 'bg-gray-100 text-gray-600 border-gray-200 hover:bg-gray-200'}`}
                        >
                            <span className={`w-2 h-2 rounded-full ${activeFilter === f ? 'bg-white' : (STATUS_COLORS[f]?.dot ?? 'bg-gray-400')}`} />
                            {FILTER_LABELS[f]?.label ?? f} ({counts[f]})
                        </button>
                    ))}
                </div>

                <div className="p-6 flex flex-col gap-4">
                    {/* Month Navigation */}
                    <div className="flex items-center justify-between">
                        <button onClick={prevMonth} className="p-2 rounded-lg hover:bg-gray-100 transition-colors text-gray-600 text-lg">
                            ‹
                        </button>
                        <span className="font-semibold text-gray-700">
                            {formatMonthYear(viewYear, viewMonth)}
                        </span>
                        <button onClick={nextMonth} className="p-2 rounded-lg hover:bg-gray-100 transition-colors text-gray-600 text-lg">
                            ›
                        </button>
                    </div>

                    {/* Weekday Headers */}
                    <div className="grid grid-cols-7 text-center text-xs font-semibold text-gray-400 uppercase tracking-wide">
                        {WEEKDAYS.map((d) => <div key={d}>{d}</div>)}
                    </div>

                    {/* Day Cells */}
                    <div className="grid grid-cols-7 gap-1">
                        {cells.map((day, idx) => {
                            if (!day) return <div key={`empty-${idx}`} />;

                            const dateStr  = `${viewYear}-${String(viewMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                            const dayAppts = apptsByDate[dateStr] ?? [];
                            const badge    = dayBadgeColor(dayAppts);
                            const isToday  = dateStr === todayStr;
                            const isSel    = day === selectedDay;

                            return (
                                <button
                                    key={day}
                                    onClick={() => setSelectedDay(day === selectedDay ? null : day)}
                                    className={`
                                        relative flex flex-col items-center justify-center rounded-xl py-2 text-sm font-medium transition-all
                                        ${isSel  ? 'ring-2 ring-offset-1 ring-indigo-400 scale-105 bg-indigo-50' : 'hover:bg-gray-50'}
                                        ${isToday && !isSel ? 'bg-indigo-50 text-indigo-700' : 'text-gray-700'}
                                        ${dayAppts.length > 0 && !isSel ? 'font-bold' : ''}
                                    `}
                                >
                                    {day}
                                    {badge && (
                                        <span className={`mt-0.5 w-2 h-2 rounded-full ${STATUS_COLORS[badge]?.dot ?? 'bg-gray-400'}`} />
                                    )}
                                </button>
                            );
                        })}
                    </div>

                    {/* Selected Day Detail */}
                    {selectedDay && (
                        <div className="border border-gray-100 rounded-xl p-4">
                            <p className="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">
                                {new Date(viewYear, viewMonth, selectedDay).toLocaleDateString('default', {
                                    weekday: 'long', month: 'long', day: 'numeric', year: 'numeric',
                                })}
                            </p>
                            {selectedAppts.length === 0 ? (
                                <p className="text-sm text-gray-400">No appointments on this day.</p>
                            ) : (
                                <ul className="flex flex-col gap-2 max-h-48 overflow-y-auto pr-1">
                                    {selectedAppts.map((appt, i) => {
                                        const status = getApptStatus(appt);
                                        const colors = STATUS_COLORS[status] ?? STATUS_COLORS.pending;
                                        const rawDate = appt.next_appointment_raw || appt.next_appointment;
                                        const timeLabel = rawDate
                                            ? dayjs(rawDate).format('h:mm A')
                                            : '—';

                                        return (
                                            <li
                                                key={appt.id ?? i}
                                                className={`flex items-center justify-between rounded-lg border px-4 py-2.5 text-sm ${colors.light}`}
                                            >
                                                <div className="flex flex-col gap-0.5">
                                                    <span className="font-semibold">{appt.patient_name}</span>
                                                    <span className="text-xs opacity-70" title={appt.service}>
                                                        {appt.service || 'No service'}
                                                    </span>
                                                </div>
                                                <div className="flex flex-col items-end gap-1 ml-4 shrink-0">
                                                    <span className="font-medium text-xs">{timeLabel}</span>
                                                    <span className={`text-xs px-2 py-0.5 rounded-full font-semibold ${colors.bg} ${colors.text}`}>
                                                        {String(status || '').replace(/^\w/, (c) => c.toUpperCase())}
                                                    </span>
                                                </div>
                                            </li>
                                        );
                                    })}
                                </ul>
                            )}
                        </div>
                    )}

                    {/* Empty state */}
                    {activeFilter && visibleAppointments.length === 0 && (
                        <div className="text-center py-6 text-sm text-gray-400">
                            No {activeFilter} appointments found.
                        </div>
                    )}
                </div>
            </div>
        </div>
    );
}
</file>

<file path="resources/js/Pages/Dashboard/Components/ScheduleTable.jsx">
import React, { useState } from 'react';
import CalendarModal from './CalendarModal';
import { STATUS_COLORS } from './calendarHelpers';
import dayjs from 'dayjs';

export default function ScheduleTable({
    appointments = [],
    calendarAppointments = [],
    stats = {},
    externalFilter = null,
    externalOpen = false,
    onCalendarClose = null,
}) {
    const [internalOpen, setInternalOpen] = useState(false);

    // Merge external open (from stat card clicks) with internal (View Calendar button)
    const isOpen = externalOpen || internalOpen;

    function handleClose() {
        setInternalOpen(false);
        if (onCalendarClose) onCalendarClose();
    }

    // Button color: driven by stats hierarchy
    const buttonColor = (() => {
        if ((stats.missed_appointments   ?? 0) > 0) return STATUS_COLORS.missed.btn;
        if ((stats.todays_appointments   ?? 0) > 0) return STATUS_COLORS.today.btn;
        if ((stats.upcoming_appointments ?? 0) > 0) return STATUS_COLORS.upcoming.btn;
        return 'bg-green-500 hover:bg-green-600';
    })();

    return (
        <>
            <div className="bg-surface border border-border rounded flex flex-col h-full">
                <div className="px-6 py-5 border-b border-border flex items-center justify-between">
                    <h2 className="text-lg font-bold font-headings">Today's Appointments</h2>
                    <button
                        className={`text-sm font-medium px-3 py-1.5 rounded transition-colors text-white ${buttonColor}`}
                        type="button"
                        onClick={() => setInternalOpen(true)}
                    >
                        View Calendar
                    </button>
                </div>

                <div className="overflow-auto">
                    <table className="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr className="border-b border-border text-muted-foreground">
                                <th className="px-6 py-3 font-medium">Next Appointment</th>
                                <th className="px-6 py-3 font-medium">Name</th>
                                <th className="px-6 py-3 font-medium">Service</th>
                                <th className="px-6 py-3 font-medium">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {appointments.length === 0 ? (
                                <tr>
                                    <td colSpan={4} className="px-6 py-10">
                                        <div className="flex flex-col items-center justify-center text-gray-500">
                                            <svg xmlns="http://www.w3.org/2000/svg" 
                                                className="h-10 w-10 mb-2 text-gray-400" 
                                                fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} 
                                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                            </svg>
                                            <p className="text-lg font-medium">No appointments scheduled for today</p>
                                            <p className="text-sm">Check upcoming or missed appointments from the dashboard.</p>
                                        </div>
                                    </td>
                                </tr>
                            ) : (
                                appointments.map((appt, idx) => (
                                    <tr
                                        key={appt.id ?? idx}
                                        className="border-b border-border last:border-0 odd:bg-gray-50 even:bg-white hover:bg-indigo-50 transition-colors"
                                    >
                                        {/* Next Appointment */}
                                        <td className="px-6 py-4 font-medium">
                                            {appt.next_appointment 
                                                ? dayjs(appt.next_appointment).format('MMM D, YYYY h:mm A') 
                                                : '—'}
                                        </td>

                                        {/* Patient Name */}
                                        <td className="px-6 py-4 font-semibold">{appt.patient_name}</td>

                                        {/* Service */}
                                        <td className="px-6 py-4 text-gray-500">{appt.service ?? '—'}</td>

                                        {/* Action Button */}
                                        <td className="px-6 py-4">
                                            <button
                                                type="button"
                                                onClick={() => {
                                                    window.location.assign(`/appointments?highlight=${appt.id}`);
                                                }}
                                                className="px-3 py-1.5 text-sm font-medium rounded bg-indigo-600 text-white hover:bg-indigo-700 transition-colors"
                                            >
                                                Details
                                            </button>
                                        </td>
                                    </tr>
                                ))
                            )}
                        </tbody>
                    </table>
                </div>
            </div>

            {isOpen && (
                <CalendarModal
                    appointments={calendarAppointments}
                    onClose={handleClose}
                    initialFilter={externalFilter}
                />
            )}
        </>
    );
}
</file>

<file path="resources/js/Pages/Dashboard/Pages/Dashboard.jsx">
import { useState } from 'react';
import { Head, usePage } from '@inertiajs/react';
import { CalendarDays, Sparkles, Users, Wallet } from 'lucide-react';
import ClinicLayout from '@/Layouts/ClinicLayout';
import OverviewStatCard from '@/Pages/Dashboard/Components/OverviewStatCard';
import TodaySchedule from '@/Pages/Dashboard/Components/TodaySchedule';
import ClinicOverview from '@/Pages/Dashboard/Components/ClinicOverview';
import CalendarModal from '@/Pages/Dashboard/Components/CalendarModal';

function formatPeso(amount) {
    const value = Number(amount) || 0;
    const compact = (n, suffix) => `₱${n.toFixed(1).replace(/\.0$/, '')}${suffix}`;

    if (value >= 1_000_000) return compact(value / 1_000_000, 'M');
    if (value >= 1_000) return compact(value / 1_000, 'K');
    return `₱${Math.round(value).toLocaleString('en-PH')}`;
}

function revenueCaption(change, previousMonth) {
    if (change === null || change === undefined) return 'Collected this month';
    return `${change > 0 ? '+' : ''}${change}% from ${previousMonth}`;
}

export default function Dashboard({ today, stats, activity, todayAppointments, calendarAppointments }) {
    const { auth } = usePage().props;
    const [calendarOpen, setCalendarOpen] = useState(false);

    const firstName = String(auth.user?.name ?? '').trim().split(/\s+/)[0] || 'there';

    return (
        <ClinicLayout>
            <Head title="Overview" />

            <div className="mx-auto w-full max-w-[1600px] space-y-6 px-5 py-10 lg:px-16">
                {/* Greeting */}
                <div className="flex flex-wrap items-end justify-between gap-4 pb-3">
                    <div>
                        <p className="text-[13px] font-semibold uppercase tracking-[0.18em] text-clinic-accent">{today.label}</p>
                        <h1 className="mt-3 text-[2.75rem] font-semibold leading-tight tracking-[-0.02em] text-clinic-ink">
                            {today.greeting}, {firstName}
                        </h1>
                        <p className="mt-3 text-[16px] text-slate-500">Here&rsquo;s what&rsquo;s happening at Dental Horizone today.</p>
                    </div>

                    <button
                        type="button"
                        onClick={() => setCalendarOpen(true)}
                        className="flex items-center gap-2.5 rounded-xl border border-clinic-line bg-white px-6 py-3.5 text-[15px] font-semibold text-clinic-ink shadow-sm transition hover:bg-slate-50"
                    >
                        <CalendarDays className="h-5 w-5" />
                        View calendar
                    </button>
                </div>

                {/* Stat cards */}
                <div className="grid grid-cols-1 gap-5 sm:grid-cols-2 2xl:grid-cols-4">
                    <OverviewStatCard
                        label="Today's appointments"
                        value={stats.todays_appointments}
                        caption={`${stats.remaining_today} remaining today`}
                        icon={CalendarDays}
                        tone="blue"
                    />
                    <OverviewStatCard
                        label="Active patients"
                        value={stats.active_patients}
                        caption={`+${stats.new_patients_month} this month`}
                        icon={Users}
                        tone="green"
                    />
                    <OverviewStatCard
                        label="Pending requests"
                        value={stats.pending_requests}
                        caption="Needs your attention"
                        icon={Sparkles}
                        tone="orange"
                    />
                    <OverviewStatCard
                        label="Monthly revenue"
                        value={formatPeso(stats.monthly_revenue)}
                        caption={revenueCaption(stats.revenue_change, stats.previous_month_label)}
                        icon={Wallet}
                        tone="purple"
                    />
                </div>

                {/* Schedule + overview */}
                <div className="grid grid-cols-[minmax(0,1fr)] items-stretch gap-6 xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
                    <TodaySchedule dateLabel={today.full} appointments={todayAppointments ?? []} />
                    <ClinicOverview activity={activity} />
                </div>
            </div>

            {calendarOpen && (
                <CalendarModal
                    appointments={calendarAppointments ?? []}
                    onClose={() => setCalendarOpen(false)}
                    initialFilter={null}
                />
            )}
        </ClinicLayout>
    );
}
</file>

<file path="resources/js/Pages/Patients/InlineForm.jsx">
import React from 'react';
import { useForm, router } from '@inertiajs/react';
import { LoaderIcon } from 'lucide-react';
import TextInput from '@/Components/TextInput';
import InputError from '@/Components/InputError';

function Field({ label, error, children }) {
    return (
        <div>
            <label className="mb-2 block text-[13px] font-semibold text-clinic-ink">
                {label}
            </label>
            {children}
            <InputError message={error} className="mt-1.5 text-[12px]" />
        </div>
    );
}

export default function InlineForm({
    patient = {},
    onSuccess = null,
    onCancel = null,
}) {
    const isNew = !patient || !patient.id;

    const { data, setData, post, put, processing, errors } = useForm({
        patient_name: patient?.patient_name || '',
        age: patient?.age || '',
        occupation: patient?.occupation || '',
        telephone: patient?.telephone || '',
        address: patient?.address || '',
        email: patient?.email || '',
    });

    function submit(e) {
        e.preventDefault();
        const done = (page) => {
            onSuccess ? onSuccess(page) : router.visit(route('patients.index'));
        };
        if (isNew) post(route('patients.store'), { onSuccess: done });
        else put(route('patients.update', patient.id), { onSuccess: done });
    }

    return (
        <form onSubmit={submit} className="space-y-5">
            <Field label="Name" error={errors.patient_name}>
                <TextInput
                    variant="clinic"
                    value={data.patient_name}
                    onChange={(e) => setData('patient_name', e.target.value)}
                    placeholder="Enter patient name"
                    required
                    disabled={processing}
                />
            </Field>

            <div className="grid grid-cols-2 gap-5">
                <Field label="Age" error={errors.age}>
                    <TextInput
                        variant="clinic"
                        type="number"
                        value={data.age}
                        onChange={(e) => setData('age', e.target.value)}
                        placeholder="Age"
                        disabled={processing}
                    />
                </Field>
                <Field label="Occupation" error={errors.occupation}>
                    <TextInput
                        variant="clinic"
                        value={data.occupation}
                        onChange={(e) => setData('occupation', e.target.value)}
                        placeholder="Enter occupation"
                        disabled={processing}
                    />
                </Field>
            </div>

            <Field label="Contact number" error={errors.telephone}>
                <TextInput
                    variant="clinic"
                    value={data.telephone}
                    onChange={(e) => setData('telephone', e.target.value)}
                    placeholder="+63"
                    disabled={processing}
                />
            </Field>

            <Field label="Email" error={errors.email}>
                <TextInput
                    variant="clinic"
                    type="email"
                    value={data.email}
                    onChange={(e) => setData('email', e.target.value)}
                    placeholder="name@example.com"
                    disabled={processing}
                />
            </Field>

            <Field label="Address" error={errors.address}>
                <TextInput
                    variant="clinic"
                    value={data.address}
                    onChange={(e) => setData('address', e.target.value)}
                    placeholder="Enter complete address"
                    disabled={processing}
                />
            </Field>

            <div className="flex items-center justify-end gap-3 border-t border-clinic-line pt-6">
                <button
                    type="button"
                    onClick={onCancel}
                    className="rounded-xl border border-clinic-line bg-white px-6 py-3 text-[14px] font-semibold text-clinic-ink transition hover:bg-slate-50"
                >
                    Cancel
                </button>
                <button
                    type="submit"
                    disabled={processing}
                    className="flex items-center gap-2 rounded-xl bg-clinic-navy px-6 py-3 text-[14px] font-semibold text-white shadow-sm transition hover:bg-[#0f3a5c] disabled:opacity-60"
                >
                    {processing && (
                        <LoaderIcon className="h-4 w-4 animate-spin" />
                    )}
                    {processing
                        ? isNew
                            ? 'Creating...'
                            : 'Saving...'
                        : isNew
                          ? 'Create patient'
                          : 'Save changes'}
                </button>
            </div>
        </form>
    );
}
</file>

<file path="routes/web.php">
<?php

use App\Http\Controllers\ProfileController;
use Illuminate\Support\Facades\Route;
use Illuminate\Support\Facades\Auth;
use Inertia\Inertia;
use App\Http\Controllers\PatientController;
use App\Http\Controllers\ArchivedPatientController;
use App\Http\Controllers\PatientVisitHistoryController;
use App\Http\Controllers\AppointmentController;
use App\Http\Controllers\ServiceController;
use App\Http\Controllers\DashboardController;
use App\Http\Controllers\BillingController;
use App\Models\Service;

Route::get('/', function () {
    return Inertia::render('Landing', [
        'services' => Service::all(),
    ]);
})->name('landing');

// Public booking route (patients can book without login)
Route::post('/appointments/public-store', [AppointmentController::class, 'publicStore'])->name('appointments.publicStore');

Route::get('/login', fn () => Inertia::render('Auth/Login'))->name('login');

/*
|--------------------------------------------------------------------------
| Authenticated Routes
|--------------------------------------------------------------------------
*/
Route::middleware(['auth', 'verified'])->group(function () {

    // Dashboard
    Route::get('/dashboard', [DashboardController::class, 'index'])->name('dashboard');

    //Billing
    Route::get('/billing', [BillingController::class, 'index'])->name('billing.index');
    Route::post('/billing/{bill}/pay', [BillingController::class, 'recordPayment'])->name('billing.pay');

    // Profile
    Route::get('/profile', [ProfileController::class, 'edit'])->name('profile.edit');
    Route::patch('/profile', [ProfileController::class, 'update'])->name('profile.update');
    Route::delete('/profile', [ProfileController::class, 'destroy'])->name('profile.destroy');

    // Patients
    Route::resource('patients', PatientController::class);
    Route::post('patients/{patient}/archive', [PatientController::class, 'archive'])->name('patients.archive');
    Route::post('archived-patients/{archived}/restore', [PatientController::class, 'restore'])->name('archived-patients.restore');

    // Other Resources
    Route::resource('visit-histories', PatientVisitHistoryController::class);
    
    //JSON endpoint for services
    Route::get('/services/list', [ServiceController::class, 'list'])->name('services.list');
    // ✅ Dental Services
    Route::resource('services', ServiceController::class);
    
    // Page Routes
    Route::get('/patients', [PatientController::class, 'index'])->name('patients.index');

    // Appointments main table
    Route::resource('appointments', AppointmentController::class);

    
    // Upcoming & Missed Appointments
    Route::get('/Appointments/Upcoming', [AppointmentController::class, 'upcoming'])->name('appointments.upcoming');
    Route::get('/Appointments/Missed', [AppointmentController::class, 'missed'])->name('appointments.missed');

    // Reschedule & Cancel
    Route::put('/appointments/{id}/reschedule', [AppointmentController::class, 'reschedule'])->name('appointments.reschedule');
    Route::put('/appointments/{id}/cancel', [AppointmentController::class, 'cancel'])->name('appointments.cancel');

    Route::get('/payments', fn () => Inertia::render('Payments/Index'))->name('payments.index');
    Route::get('/reports', fn () => Inertia::render('Reports/Index'))->name('reports.index');
    Route::get('/settings', fn () => Inertia::render('Settings/Index'))->name('settings.index');
});

require __DIR__.'/auth.php';

/*
|--------------------------------------------------------------------------
| Logout
|--------------------------------------------------------------------------
*/
Route::post('/logout', function () {
    Auth::logout();
    request()->session()->invalidate();
    request()->session()->regenerateToken();
    return redirect('/');
})->name('logout');
</file>


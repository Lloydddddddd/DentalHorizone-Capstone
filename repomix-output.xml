            'password' => 'hashed',
            'is_admin' => 'boolean',
        ];
    }

    public function visitHistories()
    {
        return $this->hasMany(PatientVisitHistory::class);
    }

    public function archivedPatients()
    {
        return $this->hasMany(ArchivedPatient::class);
    }
}

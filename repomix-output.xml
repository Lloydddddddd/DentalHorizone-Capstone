    const [deleting, setDeleting] = useState(null);

    const openAdd = () => {
        setEditing(null);
        setShowFormModal(true);
    };

    const openEdit = (service) => {
        setEditing(service);
        setShowFormModal(true);
    };

    const openDelete = (service) => {
        setDeleting(service);
        setShowDeleteModal(true);

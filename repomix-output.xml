}

/* ── Deterministic tile accents (cycles across the catalog) ───────── */
const TILE_TONES = [
    "bg-[#eaf0fb] text-clinic-blue",
    "bg-[#e6f6f2] text-[#1f9d7e]",
    "bg-[#fdf1e1] text-[#e98b2a]",
    "bg-[#f0ebf9] text-[#6b4fb3]",
